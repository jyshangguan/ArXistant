#!/bin/sh

set -e

if command -v systemctl >/dev/null 2>&1; then
    systemctl --global enable arxistant.service >/dev/null 2>&1 || true
fi

cat <<'EOF'
ArXistant installed.

The user service will start automatically at the next login. To start it now:
  systemctl --user daemon-reload
  systemctl --user enable --now arxistant.service

Load the Chrome extension from:
  /usr/share/arxistant/chrome-extension
EOF
