#!/usr/bin/env python3
"""Native messaging host for ArXistant.  Chrome starts this process and
communicates via stdin/stdout with length-prefixed JSON messages."""

import json
import struct
import subprocess
import sys


def read_message():
    raw_length = sys.stdin.buffer.read(4)
    if not raw_length or len(raw_length) < 4:
        sys.exit(0)
    message_length = struct.unpack("=I", raw_length)[0]
    return json.loads(sys.stdin.buffer.read(message_length))


def send_message(obj):
    encoded = json.dumps(obj).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("=I", len(encoded)))
    sys.stdout.buffer.write(encoded)
    sys.stdout.buffer.flush()


def main():
    try:
        request = read_message()
    except (json.JSONDecodeError, struct.error):
        send_message({"success": False, "error": "Invalid message"})
        return

    action = request.get("action", "")
    if action != "start-server":
        send_message({"success": False, "error": f"Unknown action: {action}"})
        return

    # Try systemd: daemon-reload (pick up new/updated unit files), enable
    # (persist across reboots), then start.  All three are idempotent.
    for cmd in (
        ["systemctl", "--user", "daemon-reload"],
        ["systemctl", "--user", "enable", "arxistant.service"],
        ["systemctl", "--user", "start", "arxistant.service"],
    ):
        result = subprocess.run(
            cmd, capture_output=True, text=True, timeout=30,
        )
        if result.returncode != 0:
            send_message({"success": False, "error": result.stderr.strip() or result.stdout.strip()})
            return

    send_message({"success": True, "started": "systemd"})


if __name__ == "__main__":
    main()