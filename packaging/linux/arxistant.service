[Unit]
Description=ArXistant local paper server
Documentation=https://github.com/jyshangguan/ArXistant
# Note: network-online.target does not exist in the user manager, so no
# network ordering is declared here; outbound fetches retry on failure.

[Service]
Type=simple
ExecStart=/usr/bin/arxistant-server
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
