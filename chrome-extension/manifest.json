{
  "manifest_version": 3,
  "name": "ArXistant Daily Reminder",
  "version": "0.4.2",
  "description": "Daily reminder to check your personalized arXiv astro-ph paper feed",
  "permissions": [
    "alarms",
    "nativeMessaging",
    "notifications",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8765/*",
    "https://scixplorer.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://scixplorer.org/*"],
      "js": ["content-scix.js"],
      "css": ["content-scix.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
